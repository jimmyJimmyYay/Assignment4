<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.HarshPahurkar_Assignment4" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/text_primary_light</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent</item>
        <item name="colorOnSecondary">@color/text_primary_light</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <!-- Background colors. -->
        <item name="android:colorBackground">@color/background_light</item>
        <item name="colorSurface">@color/card_background</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
        <item name="colorOnBackground">@color/text_primary_dark</item>

        <!-- Text appearance. -->
        <item name="textAppearanceHeadline1">@style/TextAppearance.AssignmentApp.Headline1</item>
        <item name="textAppearanceHeadline2">@style/TextAppearance.AssignmentApp.Headline2</item>
        <item name="textAppearanceHeadline3">@style/TextAppearance.AssignmentApp.Headline3</item>
        <item name="textAppearanceHeadline4">@style/TextAppearance.AssignmentApp.Headline4</item>
        <item name="textAppearanceHeadline5">@style/TextAppearance.AssignmentApp.Headline5</item>
        <item name="textAppearanceHeadline6">@style/TextAppearance.AssignmentApp.Headline6</item>
        <item name="textAppearanceSubtitle1">@style/TextAppearance.AssignmentApp.Subtitle1</item>
        <item name="textAppearanceSubtitle2">@style/TextAppearance.AssignmentApp.Subtitle2</item>
        <item name="textAppearanceBody1">@style/TextAppearance.AssignmentApp.Body1</item>
        <item name="textAppearanceBody2">@style/TextAppearance.AssignmentApp.Body2</item>
        <item name="textAppearanceCaption">@style/TextAppearance.AssignmentApp.Caption</item>
        <item name="textAppearanceButton">@style/TextAppearance.AssignmentApp.Button</item>
        <item name="textAppearanceOverline">@style/TextAppearance.AssignmentApp.Overline</item>
    </style>

    <!-- Text Styles with proper contrast and readability -->
    <style name="TextAppearance.AssignmentApp.Headline1" parent="TextAppearance.MaterialComponents.Headline1">
        <item name="android:textColor">@color/text_primary_dark</item>
        <item name="android:textSize">96sp</item>
    </style>

    <style name="TextAppearance.AssignmentApp.Headline2" parent="TextAppearance.MaterialComponents.Headline2">
        <item name="android:textColor">@color/text_primary_dark</item>
        <item name="android:textSize">60sp</item>
    </style>

    <style name="TextAppearance.AssignmentApp.Headline3" parent="TextAppearance.MaterialComponents.Headline3">
        <item name="android:textColor">@color/text_primary_dark</item>
        <item name="android:textSize">48sp</item>
    </style>

    <style name="TextAppearance.AssignmentApp.Headline4" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textColor">@color/text_primary_dark</item>
        <item name="android:textSize">34sp</item>
    </style>

    <style name="TextAppearance.AssignmentApp.Headline5" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/text_primary_dark</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="TextAppearance.AssignmentApp.Headline6" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/text_primary_dark</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="TextAppearance.AssignmentApp.Subtitle1" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/text_primary_dark</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.AssignmentApp.Subtitle2" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:textColor">@color/text_primary_dark</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AssignmentApp.Body1" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/text_primary_dark</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.AssignmentApp.Body2" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/text_secondary_dark</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.AssignmentApp.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/text_secondary_dark</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.AssignmentApp.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textColor">@color/text_primary_light</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.AssignmentApp.Overline" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:textColor">@color/text_secondary_dark</item>
        <item name="android:textSize">10sp</item>
    </style>

    <!-- Button Styles with good accessibility -->
    <style name="Widget.AssignmentApp.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAppearance">@style/TextAppearance.AssignmentApp.Button</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/text_primary_light</item>
        <item name="rippleColor">@color/primary_light</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>